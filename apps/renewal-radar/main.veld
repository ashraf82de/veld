use std.cli
use std.env
use std.fs
use std.io
use std.list
use std.path
use std.str
use std.time
use lib.importer
use lib.model
use lib.store

fn data_path(parsed: cli.Parsed) -> Str
  match cli.flag(parsed, "file")
    case Some(file_path) => file_path
    case None => "renewal-radar.json"
  end match
end fn

fn flag_or(parsed: cli.Parsed, name: Str, fallback: Str) -> Str
  match cli.flag(parsed, name)
    case Some(value) => value
    case None => fallback
  end match
end fn

fn add(parsed: cli.Parsed, name: Str, expiry: Str) -> Result[Str, Str] uses fs
  if str.trim(name) == ""
    return Err("name must not be empty")
  end if
  let file_path = data_path(parsed)
  let items = store.load(file_path)?
  let item = model.Renewal{
    id: model.next_id(items),
    name: str.trim(name),
    expires_ms: model.parse_expiry(expiry)?,
    owner: flag_or(parsed, name: "owner", fallback: ""),
    category: flag_or(parsed, name: "category", fallback: ""),
    notes: flag_or(parsed, name: "notes", fallback: ""),
  }
  store.save(file_path, list.push(items, item))?
  Ok("added #${item.id} ${item.name}, expires ${model.date_text(item.expires_ms)}")
end fn

fn renew(parsed: cli.Parsed, id_text: Str, expiry: Str) -> Result[Str, Str] uses fs
  let id = match str.to_int(id_text)
    case Some(value) => value
    case None => return Err("renewal id must be an integer")
  end match
  let expires_ms = model.parse_expiry(expiry)?
  let file_path = data_path(parsed)
  let items = store.load(file_path)?
  if not list.any(items, fn(item) => item.id == id)
    return Err("no renewal with id ${id}")
  end if
  let updated = list.map(
    items,
    fn(item)
      if item.id == id
        model.Renewal{..item, expires_ms: expires_ms}
      else
        item
      end if
    end fn,
  )
  store.save(file_path, updated)?
  Ok("renewed #${id} through ${model.date_text(expires_ms)}")
end fn

fn remove(parsed: cli.Parsed, id_text: Str) -> Result[Str, Str] uses fs
  let id = match str.to_int(id_text)
    case Some(value) => value
    case None => return Err("renewal id must be an integer")
  end match
  let file_path = data_path(parsed)
  let items = store.load(file_path)?
  let kept = list.filter(items, fn(item) => item.id != id)
  if list.len(kept) == list.len(items)
    return Err("no renewal with id ${id}")
  end if
  store.save(file_path, kept)?
  Ok("removed #${id}")
end fn

fn import_file(parsed: cli.Parsed, csv_path: Str) -> Result[Str, Str] uses fs
  let file_path = data_path(parsed)
  let existing = store.load(file_path)?
  let imported = importer.parse(fs.read(csv_path)?, existing)?
  let count = list.len(imported)
  if cli.has(parsed, "dry-run")
    return Ok("validated ${count_text(count)}; no duplicates; data file unchanged")
  end if
  store.save(file_path, existing + imported)?
  Ok("imported ${count_text(count)} into ${file_path}")
end fn

fn export_file(parsed: cli.Parsed, destination: Str) -> Result[Str, Str] uses env, fs
  let source = data_path(parsed)
  validate_export_path(source, destination: destination, cwd: env.cwd())?
  let items = store.load(source)?
  store.save(destination, items)?
  Ok("exported ${count_text(list.len(items))} to ${destination}")
end fn

fn validate_export_path(source: Str, destination: Str, cwd: Str) -> Result[Unit, Str]
  if str.trim(destination) == ""
    return Err("export path must not be empty")
  end if
  let clean_source = absolute_path(source, cwd)
  let clean_destination = absolute_path(destination, cwd)
  if clean_destination == clean_source or clean_destination == "${clean_source}.bak" or clean_destination == "${clean_source}.tmp"
    return Err("export path must differ from the active data file and its .bak/.tmp companions")
  end if
  Ok(Unit)
end fn

fn absolute_path(value: Str, cwd: Str) -> Str
  if path.is_absolute(value)
    path.clean(value)
  else
    path.join([cwd, value])
  end if
end fn

fn count_text(count: Int) -> Str
  if count == 1
    "1 renewal"
  else
    "${count} renewals"
  end if
end fn

fn show(parsed: cli.Parsed, id_text: Str, now_ms: Int) -> Result[Str, Str] uses fs
  let id = match str.to_int(id_text)
    case Some(value) => value
    case None => return Err("renewal id must be an integer")
  end match
  let items = store.load(data_path(parsed))?
  match list.find(items, fn(item) => item.id == id)
    case None => Err("no renewal with id ${id}")
    case Some(item) => Ok(
      str.join(
        [
          "id: ${item.id}",
          "name: ${item.name}",
          "expires: ${model.date_text(item.expires_ms)}",
          "status: ${model.status(item, now_ms)}",
          "owner: ${display_value(item.owner)}",
          "category: ${display_value(item.category)}",
          "notes: ${display_value(item.notes)}",
        ],
        "\n",
      ),
    )
  end match
end fn

fn list_text(items: List[model.Renewal], now_ms: Int) -> Str
  if list.is_empty(items)
    return "No renewals tracked."
  end if
  model.sorted(items)
    |> list.map(fn(item) => row(item, now_ms))
    |> str.join("\n")
end fn

fn row(item: model.Renewal, now_ms: Int) -> Str
  "#${item.id} | ${model.date_text(item.expires_ms)} | ${model.status(item, now_ms)} | ${item.name} | owner=${display_value(item.owner)} | category=${display_value(item.category)}"
end fn

fn display_value(value: Str) -> Str
  if value == ""
    "-"
  else
    value
  end if
end fn

fn normalized_filter(parsed: cli.Parsed, name: Str) -> Result[Str, Str]
  let value = str.trim(flag_or(parsed, name: name, fallback: ""))
  if cli.has(parsed, name) and value == ""
    return Err("--${name} must not be empty")
  end if
  Ok(str.lower(value))
end fn

fn filter_items(items: List[model.Renewal], owner: Str, category: Str) -> List[model.Renewal]
  list.filter(
    items,
    fn(item)
      let owner_matches = owner == "" or str.lower(str.trim(item.owner)) == owner
      let category_matches = category == "" or str.lower(str.trim(item.category)) == category
      owner_matches and category_matches
    end fn,
  )
end fn

fn filtered_text(items: List[model.Renewal], now_ms: Int, owner: Str, category: Str) -> Str
  list_text(filter_items(items, owner: owner, category: category), now_ms)
end fn

fn due_text(items: List[model.Renewal], now_ms: Int, days: Int, owner: Str, category: Str) -> Result[Str, Str]
  if days < 0
    return Err("--days must be zero or greater")
  end if
  let filtered = filter_items(items, owner: owner, category: category)
  let due = list.filter(filtered, fn(item) => model.days_until(item, now_ms) <= days)
  Ok(list_text(due, now_ms))
end fn

fn usage() -> Str
  str.join(
    [
      "Renewal Radar tracks contracts, licenses, subscriptions, certificates, and other expiries.",
      "",
      "Commands:",
      "  add <name> <YYYY-MM-DD> [--owner=NAME] [--category=TYPE] [--notes=TEXT]",
      "  list [--owner=NAME] [--category=TYPE]",
      "  show <id>",
      "  due [--days=30] [--owner=NAME] [--category=TYPE]",
      "  health",
      "  export <json-path>",
      "  import <csv-path> [--dry-run]",
      "  renew <id> <YYYY-MM-DD>",
      "  remove <id>",
      "",
      "All commands accept --file=PATH (default: renewal-radar.json).",
    ],
    "\n",
  )
end fn

fn execute(args: List[Str], now_ms: Int) -> Result[Str, Str] uses env, fs
  let parsed = cli.parse(args)
  match parsed.positional
    case ["add", name, expiry] => add(parsed, name: name, expiry: expiry)
    case ["list"]
      let owner = normalized_filter(parsed, "owner")?
      let category = normalized_filter(parsed, "category")?
      Ok(
        filtered_text(store.load(data_path(parsed))?, now_ms: now_ms, owner: owner, category: category),
      )
    case ["show", id] => show(parsed, id_text: id, now_ms: now_ms)
    case ["due"]
      let days = match str.to_int(flag_or(parsed, name: "days", fallback: "30"))
        case Some(value) => value
        case None => return Err("--days must be an integer")
      end match
      let owner = normalized_filter(parsed, "owner")?
      let category = normalized_filter(parsed, "category")?
      due_text(store.load(data_path(parsed))?, now_ms: now_ms, days: days, owner: owner, category: category)
    case ["health"] => Ok(store.health(data_path(parsed)))
    case ["export", destination] => export_file(parsed, destination)
    case ["import", csv_path] => import_file(parsed, csv_path)
    case ["renew", id, expiry] => renew(parsed, id_text: id, expiry: expiry)
    case ["remove", id] => remove(parsed, id)
    case ["help"] | [] => Ok(usage())
    case _ => Err("unknown command or arguments\n\n${usage()}")
  end match
end fn

fn main() -> Result[Unit, Str] uses env, fs, io, time
  let output = execute(env.args(), time.now_ms())?
  io.print(output)
  Ok(Unit)
end fn

test "list and due rendering"
  let now = 86400000
  let due = model.Renewal{id: 2, name: "domain", expires_ms: now + 86400000, owner: "ops", category: "domain", notes: ""}
  let later = model.Renewal{
    id: 1,
    name: "support",
    expires_ms: now + 40 * 86400000,
    owner: "",
    category: "contract",
    notes: "",
  }
  expect list_text([later, due], now) == "#2 | 1970-01-03 | DUE 1d | domain | owner=ops | category=domain\n#1 | 1970-02-11 | OK 40d | support | owner=- | category=contract"
  expect due_text([later, due], now_ms: now, days: 30, owner: "", category: "") == Ok("#2 | 1970-01-03 | DUE 1d | domain | owner=ops | category=domain")
  expect due_text([later], now_ms: now, days: 30, owner: "", category: "") == Ok("No renewals tracked.")
  expect due_text([], now_ms: now, days: -1, owner: "", category: "") == Err("--days must be zero or greater")
  expect display_value("") == "-"
  expect display_value("ops") == "ops"
  expect count_text(1) == "1 renewal"
  expect count_text(2) == "2 renewals"
end test

test "owner and category filters"
  let now = 86400000
  let domain = model.Renewal{id: 1, name: "domain", expires_ms: now + 86400000, owner: " Ops ", category: "Domain", notes: ""}
  let support = model.Renewal{
    id: 2,
    name: "support",
    expires_ms: now + 2 * 86400000,
    owner: "ops",
    category: "contract",
    notes: "",
  }
  let license = model.Renewal{
    id: 3,
    name: "license",
    expires_ms: now + 3 * 86400000,
    owner: "sales",
    category: "contract",
    notes: "",
  }
  expect filter_items([domain, support, license], owner: "ops", category: "") == [domain, support]
  expect filter_items([domain, support, license], owner: "", category: "contract") == [support, license]
  expect filter_items([domain, support, license], owner: "ops", category: "contract") == [support]
  expect filter_items([domain, support, license], owner: "nobody", category: "") == []
  expect due_text([domain, support, license], now_ms: now, days: 30, owner: "ops", category: "domain") == Ok("#1 | 1970-01-03 | DUE 1d | domain | owner= Ops  | category=Domain")
  expect normalized_filter(cli.parse(["--owner=  OPS  "]), "owner") == Ok("ops")
  expect normalized_filter(cli.parse(["--category="]), "category") == Err("--category must not be empty")
end test

test "export path safety"
  expect validate_export_path("data.json", destination: "backups/data.json", cwd: "/work") == Ok(Unit)
  expect validate_export_path("data.json", destination: "./data.json", cwd: "/work") == Err("export path must differ from the active data file and its .bak/.tmp companions")
  expect validate_export_path("/work/data.json", destination: "data.json", cwd: "/work") == Err("export path must differ from the active data file and its .bak/.tmp companions")
  expect validate_export_path("data.json", destination: "data.json.bak", cwd: "/work") == Err("export path must differ from the active data file and its .bak/.tmp companions")
  expect validate_export_path("data.json", destination: "data.json.tmp", cwd: "/work") == Err("export path must differ from the active data file and its .bak/.tmp companions")
  expect validate_export_path("data.json", destination: "", cwd: "/work") == Err("export path must not be empty")
end test
