use std.list
use solution

test "search"
  let xs = [1, 3, 5, 7, 9, 11]
  expect solution.search(xs, 7) == Some(3)
  expect solution.search(xs, 1) == Some(0)
  expect solution.search(xs, 11) == Some(5)
  expect solution.search(xs, 4) == None
  expect solution.search([], 4) == None
  let big = list.range(0, 1000)
  expect solution.search(big, 777) == Some(777)
end test
