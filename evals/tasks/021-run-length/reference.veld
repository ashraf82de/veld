use std.list
use std.str

pub fn encode(text: Str) -> Str
  var parts: List[Str] = []
  var current = ""
  var count = 0
  for c in str.chars(text)
    if c == current
      set count = count + 1
    else
      if count > 0
        set parts = list.push(parts, "${count}${current}")
      end if
      set current = c
      set count = 1
    end if
  end for
  if count > 0
    set parts = list.push(parts, "${count}${current}")
  end if
  str.join(parts, "")
end fn

pub fn decode(text: Str) -> Result[Str, Str]
  var out: List[Str] = []
  var digits = ""
  for c in str.chars(text)
    if str.is_digit(c)
      set digits = digits + c
    else
      match str.to_int(digits)
        case Some(n)
          if n > 0
            set out = list.push(out, str.repeat(c, n))
            set digits = ""
          else
            return Err("malformed input")
          end if
        case None => return Err("malformed input")
      end match
    end if
  end for
  if digits != ""
    return Err("malformed input")
  end if
  Ok(str.join(out, ""))
end fn
