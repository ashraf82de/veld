use solution

test "days between"
  expect solution.days_between("2024-01-01", "2024-03-01") == Ok(60)
  expect solution.days_between("2024-03-01", "2024-01-01") == Ok(-60)
  expect solution.days_between("2023-12-31", "2024-01-01") == Ok(1)
  expect solution.days_between("2024-05-05", "2024-05-05") == Ok(0)
end test

test "add days"
  expect solution.add_days("2024-02-28", 2) == Ok("2024-03-01")
  expect solution.add_days("2024-01-01", -1) == Ok("2023-12-31")
  expect solution.add_days("2024-01-31", 30) == Ok("2024-03-01")
end test

test "weekday"
  expect solution.weekday_name("2024-01-01") == Ok("Monday")
  expect solution.weekday_name("2000-02-29") == Ok("Tuesday")
end test

test "invalid dates"
  expect solution.days_between("nope", "2024-01-01") == Err("invalid date: nope")
  expect solution.days_between("2024-01-01", "2024-13-01") == Err("invalid date: 2024-13-01")
  expect solution.add_days("2024-02-30", 1) == Err("invalid date: 2024-02-30")
  expect solution.weekday_name("2024-1-1") == Err("invalid date: 2024-1-1")
end test
