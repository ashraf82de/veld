# A generic binary search tree over Int keys, with persistent (immutable) inserts.
use std.io
use std.list
use std.str

type Tree[V]
  case Leaf
  case Node(left: Tree[V], key: Int, value: V, right: Tree[V])
end type

fn insert[V](t: Tree[V], key: Int, value: V) -> Tree[V]
  match t
    case Leaf => Node(left: Leaf, key: key, value: value, right: Leaf)
    case Node(l, k, v, r)
      if key < k
        Node(left: insert(l, key: key, value: value), key: k, value: v, right: r)
      else if key > k
        Node(left: l, key: k, value: v, right: insert(r, key: key, value: value))
      else
        Node(left: l, key: k, value: value, right: r)
      end if
  end match
end fn

fn lookup[V](t: Tree[V], key: Int) -> Option[V]
  match t
    case Leaf => None
    case Node(l, k, v, r)
      if key == k
        Some(v)
      else if key < k
        lookup(l, key)
      else
        lookup(r, key)
      end if
  end match
end fn

fn keys[V](t: Tree[V]) -> List[Int]
  match t
    case Leaf => []
    case Node(l, k, _, r) => keys(l) + [k] + keys(r)
  end match
end fn

fn depth[V](t: Tree[V]) -> Int
  match t
    case Leaf => 0
    case Node(l, _, _, r) => 1 + max(depth(l), depth(r))
  end match
end fn

fn max(a: Int, b: Int) -> Int
  if a > b
    a
  else
    b
  end if
end fn

fn from_list(pairs: List[Int]) -> Tree[Str]
  list.fold(pairs, init: Leaf, step: fn(t, k) => insert(t, key: k, value: "v${k}"))
end fn

fn main() -> Unit uses io
  let t = from_list([50, 30, 70, 20, 40, 60, 80])
  io.print("keys: ${keys(t)}")
  io.print("depth: ${depth(t)}")
  io.print("lookup 40: ${lookup(t, 40)}")
  io.print("lookup 45: ${lookup(t, 45)}")
  io.print(str.join(list.map(keys(t), fn(k) => "${k}"), ","))
end fn

test "bst keeps keys sorted"
  let t = from_list([5, 3, 8, 1, 4])
  expect keys(t) == [1, 3, 4, 5, 8]
  expect lookup(t, 4) == Some("v4")
  expect lookup(t, 9) == None
end test

test "insert replaces"
  let t = insert(from_list([1]), key: 1, value: "new")
  expect lookup(t, 1) == Some("new")
end test
