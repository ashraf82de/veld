# Numbers. Int is a 64-bit signed integer (overflow is a runtime error).
# Float is a 64-bit IEEE float. Nothing converts implicitly.
pub fn abs(x: Int) -> Int
  if x < 0
    -x
  else
    x
  end if
end fn

pub extern fn abs_float(x: Float) -> Float

pub fn min(a: Int, b: Int) -> Int
  if a < b
    a
  else
    b
  end if
end fn

pub fn max(a: Int, b: Int) -> Int
  if a > b
    a
  else
    b
  end if
end fn

pub extern fn min_float(a: Float, b: Float) -> Float

pub extern fn max_float(a: Float, b: Float) -> Float

## Restricts x to [low, high]: math.clamp(x, low: 0, high: 10).
pub fn clamp(x: Int, low: Int, high: Int) -> Int
  max(low, min(x, high))
end fn

pub extern fn to_float(x: Int) -> Float

## Largest Int not greater than x.
pub extern fn floor(x: Float) -> Int

## Smallest Int not less than x.
pub extern fn ceil(x: Float) -> Int

## Nearest Int, halves away from zero.
pub extern fn round(x: Float) -> Int

pub extern fn sqrt(x: Float) -> Float

pub extern fn pow(base: Float, exp: Float) -> Float

## Integer power; exp must be >= 0.
pub extern fn pow_int(base: Int, exp: Int) -> Int

pub extern fn log(x: Float) -> Float

pub extern fn exp(x: Float) -> Float

pub extern fn sin(x: Float) -> Float

pub extern fn cos(x: Float) -> Float

pub extern fn pi() -> Float

## -1, 0 or 1 according to the sign of x.
pub fn sign(x: Int) -> Int
  if x < 0
    -1
  else if x > 0
    1
  else
    0
  end if
end fn

## Greatest common divisor of |a| and |b| (gcd(0, 0) is 0).
pub fn gcd(a: Int, b: Int) -> Int
  var x = abs(a)
  var y = abs(b)
  while y != 0
    let t = x % y
    set x = y
    set y = t
  end while
  x
end fn

pub extern fn tan(x: Float) -> Float

pub extern fn asin(x: Float) -> Float

pub extern fn acos(x: Float) -> Float

pub extern fn atan(x: Float) -> Float

## The angle of the point (x, y) in radians.
pub extern fn atan2(y: Float, x: Float) -> Float

## Base-10 logarithm.
pub extern fn log10(x: Float) -> Float

pub extern fn is_nan(x: Float) -> Bool

## The part of x before the decimal point, as a Float: trunc(-2.7) == -2.0.
pub extern fn trunc(x: Float) -> Float

test "math"
  expect abs(-3) == 3
  expect clamp(15, low: 0, high: 10) == 10
  expect round(2.5) == 3
  expect floor(-1.5) == -2
  expect pow_int(2, 10) == 1024
  expect to_float(3) == 3.0
end test

test "math additions"
  expect sign(-5) == -1 and sign(0) == 0 and sign(9) == 1
  expect gcd(12, -18) == 6 and gcd(0, 0) == 0 and gcd(7, 0) == 7
  expect abs_float(atan2(1.0, 1.0) - 0.7853981633974483) < 0.000001
  expect log10(1000.0) == 3.0
  expect is_nan(0.0 / 0.0)
  expect trunc(-2.7) == -2.0
end test
