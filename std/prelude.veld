# The prelude is visible in every module without a `use`.

## An optional value: `Some(value)` or `None`. Veld has no null.
pub type Option[T]
  case Some(value: T)
  case None
end type

## The outcome of an operation that can fail. Propagate errors with `?`.
pub type Result[T, E]
  case Ok(value: T)
  case Err(error: E)
end type

## A JSON document. Parse with json.parse, render with json.encode.
pub type Json
  case JNull
  case JBool(value: Bool)
  case JNum(value: Float)
  case JStr(value: Str)
  case JArr(items: List[Json])
  case JObj(fields: Map[Str, Json])
end type

## Stops the program with an error message. Only for states that cannot happen;
## expected failures should return a Result.
pub extern fn panic[T](message: Str) -> T

## Two values, possibly of different types. Returned by list.zip,
## list.enumerate, list.partition, str.split_once and map.entries.
pub record Pair[A, B]
  first: A
  second: B
end record

## The values of a multi-value `match a, b`. The parser builds these; there is
## no need to write them yourself.
pub type Tuple2[A, B]
  case Tuple2(first: A, second: B)
end type

pub type Tuple3[A, B, C]
  case Tuple3(first: A, second: B, third: C)
end type

pub type Tuple4[A, B, C, D]
  case Tuple4(first: A, second: B, third: C, fourth: D)
end type
